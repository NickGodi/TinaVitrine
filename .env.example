# Tavily web search key. Keep it on the server; never use a VITE_ prefix.
TAVILY_API_KEY=""

# Groq vision key for identifying pasted/uploaded images. Keep it on the server.
GROQ_API_KEY=""

# Optional public URL of the deployed site. The server can infer it from the request host.
APP_URL=""

# First-run owner account. Use a unique password with at least 16 characters.
# Only used when the database is initialized for the first time.
INITIAL_CREATOR_USERNAME=""
INITIAL_CREATOR_PASSWORD=""
INITIAL_CREATOR_NAME=""

# Private server-to-server persistence for Vercel. Keep the state key server-only.
TINAVITRINE_STATE_API_URL=""
TINAVITRINE_STATE_KEY=""
SUPABASE_ANON_KEY=""

# Stripe secret keys stay on the server. Never put them in frontend code.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Add a valid Pix Copia e Cola payload here if you replace the site default.
PIX_COPY_PASTE=""

# Optional Facebook Graph API OAuth credentials for live Facebook publishing
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
