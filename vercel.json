{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth/facebook/callback",
      "destination": "/api/auth/facebook/callback"
    },
    {
      "source": "/auth/facebook/callback.js",
      "destination": "/api/auth/facebook/callback.js"
    }
  ]
}
